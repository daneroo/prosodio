# Library root selection: "fixtures" (default, committed test data) or
# "private" (external corpus). See src/lib/config.ts for the defaults each
# root resolves to.
# BOOKPLAYER_ROOT=private

# Private-root overrides (optional; no absolute paths committed here).
# AUDIOBOOKS_ROOT=
# VTT_DIR=

# Follow mode (optional): the audiobookshelf server Bookplayer follows. The URL
# may include a path (e.g. https://example.com/audiobookshelf/). The API key is
# this server's own (audiobookshelf Settings → API Keys); it never reaches the
# browser, where each device pastes its own key. Without both, follow mode
# reports "not configured".
# AUDIOBOOKSHELF_URL=
# AUDIOBOOKSHELF_API_KEY=
